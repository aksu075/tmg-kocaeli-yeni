# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/tmg_guvenlik?retryWrites=true&w=majority

# JWT Secret (minimum 32 karakter, rastgele bir string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Yeni mesaj bildirimi (isteğe bağlı) - resend.com ücretsiz hesabından alınan API anahtarı
RESEND_API_KEY=
# Bildirimin gideceği adres(ler), virgülle ayrılabilir
BILDIRIM_EPOSTA=
# Gönderen adres. Alan adı Resend'de doğrulanmadıysa boş bırakın (onboarding@resend.dev kullanılır;
# bu durumda yalnızca Resend hesabını açan e-posta adresine gönderim yapılabilir)
BILDIRIM_GONDEREN=
